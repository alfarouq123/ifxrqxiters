# GEMINI_API_KEY — wajib buat chat utama + plugin @code + @berfikir
# Dapetin di https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# (opsional) IMAGE_EDIT_API_URL — custom endpoint edit foto
# Default: https://api.synoxcloud.xyz/edit/nanobanana
# IMAGE_EDIT_API_URL=

# ====== Plugin system tambahan (opsional, tools/canvas/ai) ======
# CUKI_API_KEY       — dipakai /caribug & beberapa canvas api.cuki.biz.id (ada default publik "cuki")
CUKI_API_KEY=

# PASTEBIN_API_KEY   — dipakai /pastebin mode upload teks (daftar gratis: pastebin.com/doc_api)
PASTEBIN_API_KEY=

# QUIZ_SECRET        — buat signing token game tebak-tebakan stateless (kategori games, next phase)
QUIZ_SECRET=ganti-dengan-string-acak-punya-sendiri
